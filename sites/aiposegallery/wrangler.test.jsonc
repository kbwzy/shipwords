// Local in-memory D1 for isolated Worker tests. Never deploy this config.
{
  "name": "aiposegallery-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "test", "database_id": "local" }],
  "r2_buckets": [{ "binding": "TEST_MEDIA", "bucket_name": "aiposegallery-test-media" }]
}
