{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiposegallery",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiposegallery-db",
      "database_id": "a442a967-4bd0-4c19-b8b4-3a6d9eb839f5"
    }
  ],
  "r2_buckets": [{"binding": "POSE_MEDIA", "bucket_name": "aiposegallery-pose-media"}],
  "workflows": [{"binding": "POSE_WORKFLOW", "name": "aiposegallery-pose", "class_name": "PoseWorkflow"}],
  "triggers": {"crons": ["*/10 * * * *"]},
  "vars": {
    "POSE_TRIAL_ENABLED": "true",
    "POSE_ALLOWED_ORIGIN": "https://aiposegallery.com",
    "POSE_UPLOAD_HOSTS": "75397736ff6ffddf6c5d8208a05fa738.r2.cloudflarestorage.com",
    "POSE_RESULT_HOSTS": "75397736ff6ffddf6c5d8208a05fa738.r2.cloudflarestorage.com"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
}
